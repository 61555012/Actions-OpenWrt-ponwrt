#
# PonWrt LITE — Nokia XG-040G-MD (UBI) 叠加配置
# 目标: airoha / an7581 / nokia_xg-040g-md-ubi
#
# ============================ 纯净版定位 ============================
# 只做一件事：把光口拉起来 + 硬件加速转发（L2 桥接 / L3 路由）。
# 除 PON 驱动栈、2.5G PHY 驱动、fw4 flowtable 之外，不引入任何第三方插件。
#
# 相比标准版（.config）去掉的东西:
#   ✗ argon 主题及其设置页        -> 使用内置 luci-theme-bootstrap
#   ✗ OAF 应用识别（kmod-oaf / appfilter / luci-app-oaf）
#   ✗ mosdns v5（mosdns / luci-app-mosdns / geo2txt / v2ray-geo*）+ Go 1.27 工具链
#   ✗ UPnP（miniupnpd-nftables / luci-app-upnp）
#   ✗ luci-app-airoha-npu（NPU 状态面板，非转发必需）
#   ✗ htop / nano 等可选工具
#
# 保留的东西:
#   ✓ PON 驱动栈 + 光模块驱动（全部强制 =y）
#   ✓ 2.5G PHY EN8811H 驱动与固件（强制 =y）
#   ✓ fw4 flowtable / PPE 硬件加速 + 每流字节统计（CONFIG_NET_AIROHA_FLOW_STATS）
#   ✓ luci-app-onu / luci-app-pon-status（配置 PON 注册所必需，非可选插件）
#   ✓ 无 dummy 接口
#
# 说明: 本文件不是完整的 .config。构建时工作流会先做
#         ./scripts/kconfig.pl + configs/an7581.config configs/release.config > .config
#       把官方基线（含 UBIFS / initramfs / squashfs / 内核参数等镜像级设置）铺好，
#       只保留 040G-MD 一个设备，然后把本文件追加进去，最后 make defconfig。
#       所以这里只写"官方基线之外还想额外选中/关掉"的项。
#

#
# ---------- 目标设备（多 profile 符号，与官方 configs/an7581.config 一致）----------
#
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

#
# ---------- PON 驱动栈 / 光模块驱动（强制 =y，不用 =m）----------
# 光模块（SFP ONU 光前端 EN7572）相关驱动必须编进内核镜像，不能是外挂模块：
#   kmod-airoha-en7572       —— EN7572 光前端（DDM/温度/电压/tx-rx power 来源）
#   kmod-airoha-pon-frontend —— PON 前端抽象层
#   kmod-airoha-xpon         —— XPON MAC/PHY（GPON/EPON 收发包）
# 用户态守护进程同样强制 =y，否则首启没有 pond/ponctl，光口起不来。
#
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y

#
# ---------- 2.5G 网口 (lan1 / 2500base-x) ----------
# EN8811H 是 an7581 板载 2.5G PHY（lan1 跑 2500base-x），
# 驱动与固件都必须 =y，不能留 =m（基线里是 m，这里覆盖成 y）。
#
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y

#
# ---------- 硬件加速: L2 桥接 + L3 路由 ----------
# kmod-nf-conntrack-bridge 是 bridge flowtable 的前置，缺了就只有 L3 能卸载。
#
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y

#
# NOTE: 每流字节统计由内核符号控制，不在 .config 里 —— 见 diy-lite-part2.sh
#       CONFIG_NET_AIROHA_FLOW_STATS=y  (target/linux/airoha/an7581/config-6.18)
#

#
# ---------- LuCI ----------
# 内置 bootstrap 主题，不装 argon
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-mod-dashboard=y

#
# ---------- PON 管理界面（配置注册/桥接所必需，非可选插件）----------
#
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y

#
# ---------- 以下第三方组件在纯净版中全部关闭 ----------
# 显式写成 "is not set"，避免官方基线或 feeds 默认值把它们带进来
#
# argon 主题
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
#
# OAF 应用识别
# CONFIG_PACKAGE_kmod-oaf is not set
# CONFIG_PACKAGE_appfilter is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
#
# mosdns v5 / 分流数据
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_geo2txt is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set
#
# UPnP
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_miniupnpd-iptables is not set
#
# NPU 状态面板
# CONFIG_PACKAGE_luci-app-airoha-npu is not set
#
# 可选工具
# CONFIG_PACKAGE_htop is not set

#
# ---------- 去除 dummy 接口 ----------
#
# CONFIG_PACKAGE_kmod-dummy is not set
#
