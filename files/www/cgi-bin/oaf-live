#!/bin/sh
# 用户列表的 1 秒快通道。
#
# 走这个 CGI 而不是 /cgi-bin/luci/admin/status/oaf_users/api/live_rates，
# 是因为 LuCI 的每个接口请求都要起一个完整的 Lua 进程（dispatcher + session
# + 控制器），实测中位 190 ms、常驻 10% 以上一个核；这里只有 sh + cat，
# 实测 30 ms，也不占 Lua 的几 MB 内存。
#
# 同时把「有人在看」的心跳写进 watched：采样器只有在看到这个标记时才从
# 20 秒切到 1 秒采样，所以心跳必须跟着快通道一起发。
printf 1 > /tmp/oaf-flow/watched 2>/dev/null

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store, no-cache, must-revalidate\r\n\r\n'

if [ -r /tmp/oaf-flow/stats.json ]; then
	cat /tmp/oaf-flow/stats.json
else
	printf '{}'
fi
