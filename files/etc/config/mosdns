
config mosdns 'config'
	option enabled '1'
	option geo_auto_update '1'
	option geo_update_week_time '*'
	option geo_update_day_time '2'
	option geoip_type 'geoip-only-cn-private'
	option configfile '/var/etc/mosdns.json'
	option log_file '/var/log/mosdns.log'
	option cache '1'
	option enable_pipeline '1'
	option insecure_skip_verify '0'
	option dns_leak '0'
	option cloudflare '0'
	option listen_port_api '9091'
	option redirect '1'
	option prefer_ipv4 '1'
	option enable_ecs_remote '0'
	option dump_file '0'
	option reject_type65 '1'
	option stats_collector '1'
	option stats_dump_file '0'
	option prefetch '0'
	option local_dns_redirect '1'
	option prefer_ipv4_cn '1'
	option bootstrap_dns '223.5.5.5'
	option custom_local_dns '1'
	list local_dns '112.4.0.55'
	list local_dns '221.131.143.69'
	list local_dns '223.5.5.5'
	list local_dns '119.29.29.29'
# 广告拦截默认关闭：mosdns.uc 的 get_adlist() 只在 adblock!=1 时才创建
# /var/mosdns/disable-ads.txt；adblock=1 而 ad_source 为空时，它会把这个不存在的
# 文件塞进 adlist 插件，mosdns 启动即 FATAL，dnsmasq(127.0.0.1#5335) 没了上游，
# 全网 DNS 死掉，NTP 用域名也就永远校不回时间。
# 要开拦截：先在 LuCI 里填 ad_source（或 uci add_list mosdns.config.ad_source=...），
# 让 update_adlist 真正落一份列表，再把这里改回 1。
	option adblock '0'
	option github_proxy 'https://gh-proxy.com'

