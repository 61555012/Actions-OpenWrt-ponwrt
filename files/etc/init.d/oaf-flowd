#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/oaf-flowd
CONF=/etc/oaf/oaf-flowd.conf

start_service() {
	[ -f "$CONF" ] && . "$CONF"
	mkdir -p /etc/oaf/data /tmp/oaf
	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

reload_service() {
	stop
	start
}
