#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/oaf-flowd
CONF=/etc/oaf/oaf-flowd.conf
DATA=/etc/oaf/data

# day/ 与 mon/ 必须存在：oaf-flowd 不会自建这两个子目录，缺了它只在内存里统计、
# 一个字节都不落盘（历史流量 / 月流量会一直是 0）。
# 只在 start_service 里建一次不够 —— procd respawn 不会再走 start_service，
# 运行中目录被清掉（格式化 overlay、手工 rm -rf /etc/oaf）就补不回来了。
# 所以交给 procd 的 wrapper 每次拉起都重建，再 exec 成真正的采样器：
# exec 后 pid 不变、comm 仍是 oaf-flowd，ps / pgrep 行为不受影响。
start_service() {
	[ -f "$CONF" ] && . "$CONF"
	mkdir -p "$DATA/day" "$DATA/mon" /tmp/oaf
	procd_open_instance
	procd_set_param env OAF_FLOW_DATA="$DATA"
	procd_set_param command /bin/sh -c "mkdir -p $DATA/day $DATA/mon /tmp/oaf; exec $PROG serve"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

reload_service() {
	stop
	start
}
