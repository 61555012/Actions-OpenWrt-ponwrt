#!/bin/sh /etc/rc.common
# oaf-ctstat: hardware-offload-safe conntrack accounting for the OAF user pages.
# ALL data is tmpfs: /tmp/oaf-flow/{stats,hourly,apps}.json, day/, logs.
# Nothing is written to flash; a reboot clears traffic and app statistics.
# oafd, oaf.ko, UCI and firewall config are untouched.

START=99
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /tmp/oaf-flow/day
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/lib/lua/oaf_ctstat.lua
	# 5 次以内重启会被 procd 当成"崩溃循环"永久放弃，页面就开始吃旧值；
	# 放宽到 20 次，给上层排查留出时间窗，而不是直接静默停止。
	procd_set_param respawn 3600 5 20
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# The Lua process spawns a `conntrack -E` child; procd only tracks the
	# parent, so retire the child explicitly.
	if [ -f /tmp/oaf-flow/events.pid ]; then
		kill "$(cat /tmp/oaf-flow/events.pid)" 2>/dev/null
		rm -f /tmp/oaf-flow/events.pid
	fi
}
