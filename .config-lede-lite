#
# 040G-MD 纯净版（LEDE 源码）—— Nokia XG-040G-MD (UBI) 目标种子
# 源码: coolsnowwolf/lede (master)  target: airoha / an7581 / nokia_xg-040g-md-ubi
#
# ============================ 与 PonWrt 纯净版的区别 ============================
# 只换底层源码树（LEDE 内核/驱动/默认包体系），定位与包集合保持一致：
# 光口能起来 + 硬件加速转发，不装任何第三方插件。
#
# LEDE 没有官方 an7581 基线 config，本文件是【最小种子】：
#   写目标 + 要显式选的包 → 其余交给 make defconfig 按 LEDE 默认值补齐。
#
# 保留:
#   ✓ PON 驱动栈 + 光模块驱动（来自 pbs05 的 pon_drivers / pon_userspace feeds）
#   ✓ 2.5G PHY EN8811H 驱动与固件
#   ✓ fw4 flowtable / PPE 硬件加速 + 每流字节统计（CONFIG_NET_AIROHA_FLOW_STATS）
#   ✓ luci + 内置 bootstrap 主题 + luci-app-onu / luci-app-pon-status
#   ✓ 拨号链路: ppp + ppp-mod-pppoe + luci-proto-ppp（PPPoE 拨号）
#   ✓ dnsmasq-full / odhcp6c / odhcpd-ipv6only（DHCP + IPv6）
#   ✓ 无 dummy 接口，默认 root 密码 admin123
#
# 排除（LEDE 的 DEFAULT_PACKAGES.router 默认带，已由 diy-lede-lite-2.sh 白名单化）:
#   ✗ ssr-plus / passwall / openclash / bypass / vssr 等代理插件
#   ✗ turboacc / upnp / ddns / wol / vsftpd / vlmcsd / nlbwmon / autoreboot / arpbind 等 lean 插件
#   ✗ argon 主题 ✗ OAF ✗ mosdns ✗ NPU 面板 ✗ kmod-tun / tproxy（透明代理专用）
#

#
# ---------- 目标 ----------
# LEDE 未启用 MULTI_PROFILE，设备用单 profile 符号；
# 同时写一份多 profile 符号，万一上游切到该模式也不会选不中。
#
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

#
# ---------- LuCI（LEDE 里不是默认选中，必须显式开）----------
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y

#
# ---------- PON 驱动栈 / 光模块驱动（强制 =y）----------
#
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y

#
# ---------- 2.5G 网口 (lan1 / 2500base-x) ----------
#
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y

#
# ---------- 硬件加速: L2 桥接 + L3 路由 ----------
# LEDE 的 an7581 DEFAULT_PACKAGES 不含这些，全部显式选。
# 注意: LEDE 没有 kmod-nf-conntrack-bridge 这个包，
#       CONFIG_BRIDGE_NETFILTER / CONFIG_NF_CONNTRACK_BRIDGE 由 diy-lede-lite-2.sh
#       直接写进 target/linux/airoha/an7581/config-6.18 编成 =y。
#
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

#
# NOTE: 每流字节统计由内核符号控制 —— 见 diy-lede-lite-2.sh
#       CONFIG_NET_AIROHA_FLOW_STATS=y  (target/linux/airoha/an7581/config-6.18)
#

#
# ---------- PON 管理界面（配注册/桥接所必需）----------
#
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y

#
# ---------- 拨号 / 基础路由（显式选中，其余一律不装）----------
# LEDE 的 DEFAULT_PACKAGES.router 自带一堆 lean 插件（见下），
# diy-lede-lite-2.sh 里已把默认包清单改成白名单；这里再显式选一遍，
# 保证即使上游改了默认包，拨号链路也不会缺件。
#
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

#
