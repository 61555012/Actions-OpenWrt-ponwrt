#
# PonWrt — Nokia XG-040G-MD (UBI) 叠加配置
# 目标: airoha / an7581 / nokia_xg-040g-md-ubi
#
# 说明: 本文件不是完整的 .config。构建时工作流会先做
#         ./scripts/kconfig.pl + configs/an7581.config configs/release.config > .config
#       把官方基线（含 UBIFS / initramfs / squashfs / 内核参数等镜像级设置）铺好，
#       只保留 040G-MD 一个设备，然后把本文件追加进去，最后 make defconfig。
#       所以这里只写"官方基线之外还想额外选中/关掉"的项。
#

#
# ---------- 目标设备（多 profile 符号，与官方 configs/an7581.config 一致）----------
#
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

#
# ---------- PON 驱动栈 ----------
# 官方基线与设备默认包已含: kmod-airoha-xpon / kmod-airoha-pon-frontend /
# kmod-airoha-en7572 / airoha-pond / airoha-ponctl / airoha-pon-debug，
# 这里显式写出，防止上游调整 DEFAULT_PACKAGES 时悄悄丢失。
#
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pon-debug=y

#
# ---------- 2.5G 网口 (lan1 / 2500base-x) ----------
# 官方基线是 =m（模块），保持不动即可满足 2500base-x 协商。
#
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=m

#
# ---------- 硬件加速: L2 桥接 + L3 ----------
#
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y

#
# NOTE: 每流字节统计由内核符号控制，不在 .config 里 —— 见 diy-part2.sh
#       CONFIG_NET_AIROHA_FLOW_STATS=y  (target/linux/airoha/an7581/config-6.18)
#

#
# ---------- 主题: argon v3.1.1（diy-part3.sh 覆盖 feeds 旧版）----------
#
CONFIG_PACKAGE_luci-theme-argon=y

#
# ---------- 插件 ----------
#
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y
CONFIG_PACKAGE_luci-app-airoha-npu=y

#
# ---------- OAF 应用识别（diy-part2.sh 拉取 destan19/OpenAppFilter 最新版）----------
# 配合 files/etc/fwxd/feature.bin 与 files/www/luci-static/resources/oaf/app_icons
#
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y

#
# ---------- UPnP (miniupnpd) ----------
# fw4 是 nftables，必须选 nftables 变体；-iptables 变体与它互斥
# 配置取自 files/etc/config/upnpd
#
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set

#
# ---------- mosdns v5 ----------
# 本体用 feeds 里的 net/mosdns (5.3.x = v5)；
# LuCI 界面与 geo2txt 由 diy-part2.sh 从 sbwml/luci-app-mosdns 拉取
#
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_geo2txt=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

#
# luci-app-airoha-npu 靠 busybox devmem 读 FrameEngine/PLL 寄存器
#
CONFIG_BUSYBOX_DEFAULT_DEVMEM=y

#
# ---------- 常用工具 ----------
# 官方基线已含 curl 等，这里补齐日常排障用的
#
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

#
# ---------- 去除 dummy 接口 ----------
#
# CONFIG_PACKAGE_kmod-dummy is not set
