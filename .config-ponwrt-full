#
# PonWrt — Nokia XG-040G-MD (UBI) 叠加配置
# 目标: airoha / an7581 / nokia_xg-040g-md-ubi
#
# 说明: 本文件不是完整的 .config。构建时工作流会先做
#         ./scripts/kconfig.pl + configs/an7581.config configs/release.config > .config
#       把官方基线（含 UBIFS / initramfs / squashfs / 内核参数等镜像级设置）铺好，
#       只保留 040G-MD 一个设备，然后把本文件追加进去，最后 make defconfig。
#       所以这里只写"官方基线之外还想额外选中/关掉"的项。
#

#
# ---------- 目标设备（多 profile 符号，与官方 configs/an7581.config 一致）----------
#
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

#
# ---------- PON 驱动栈 / 光模块驱动（强制 =y，不用 =m）----------
# 光模块（SFP ONU 光前端 EN7572）相关驱动必须编进内核镜像，不能是外挂模块：
#   kmod-airoha-en7572       —— EN7572 光前端（DDM/温度/电压/tx-rx power 来源）
#   kmod-airoha-pon-frontend —— PON 前端抽象层
#   kmod-airoha-xpon         —— XPON MAC/PHY（GPON/EPON 收发包）
# 用户态守护进程同样强制 =y，否则首启没有 pond/ponctl，光口起不来。
#
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pon-debug=y

#
# ---------- 2.5G 网口 (lan1 / 2500base-x) ----------
# EN8811H 是 an7581 板载 2.5G PHY（lan1 跑 2500base-x），
# 驱动与固件都必须 =y，不能留 =m（基线里是 m，这里覆盖成 y）。
#
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y

#
# ---------- 硬件加速: L2 桥接 + L3 ----------
#
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y

#
# NOTE: 每流字节统计由内核符号控制，不在 .config 里 —— 见 diy-part2.sh
#       CONFIG_NET_AIROHA_FLOW_STATS=y  (target/linux/airoha/an7581/config-6.18)
#

#
# ---------- 主题: argon v3.1.1（diy-part3.sh 覆盖 feeds 旧版）----------
#
CONFIG_PACKAGE_luci-theme-argon=y

#
# ---------- 插件 ----------
#
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y
CONFIG_PACKAGE_luci-app-airoha-npu=y

#
# ---------- Lua 兼容层: 状态-用户列表(oaf_status) 需要 ----------
# files/ 里的 oaf_status 插件是 Lua 版（luci.controller / model.cbi / view.htm），
# 而 PonWrt 默认是纯 ucode 版 LuCI，没有 lua 解释器与 lua 版 dispatcher：
#   - luci-compat  : 提供 /usr/lib/lua/luci/{dispatcher,cbi,template,view,model,...}
#   - ucode-mod-lua: /usr/lib/ucode/lua.so，ucode dispatcher 靠它加载 lua controller
#   - luci-lib-*   : controller 里 require 的 jsonc / nixio
# 关掉这几个，页面会 404 或报 "attempt to require luci.jsonc"。
#
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_ucode-mod-lua=y

#
# ---------- OAF 识别内核: oafd(appfilter) + kmod-oaf ----------
# 「状态 → 用户列表」的两块数据靠这两个包，缺了页面照开但内容空：
#   kmod-oaf    内核模块(oaf.ko)，在 conntrack 里写应用标记，
#               导出 /proc/net/{af_visit,af_client,fwx_user}
#   appfilter   用户态 oafd + 特征库(/etc/fwxd/feature.bin) + /etc/init.d/appfilter,
#               维护 /tmp/oaf/client.db(访问记录/APP 时长), oaf-flowd 从这里补 30 天访问历史
# 只要内核和守护，不要 luci-app-oaf 界面（diy-part2 里会删掉那个目录，
# 自研「用户列表」插件已完全替代它，留着会出现第二套重复菜单）。
# appfilter 的 DEPENDS 里有 libuci-lua / libsqlite3 / libcurl，这里显式钉住，
# 避免 appfilter 因为找不到 lua uci 绑定被 buildroot 静默跳过。
#
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_libsqlite3=y
CONFIG_PACKAGE_libcurl=y

#
# ---------- UPnP (miniupnpd) ----------
# fw4 是 nftables，必须选 nftables 变体；-iptables 变体与它互斥
# 配置取自 files/etc/config/upnpd
#
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set

#
# ---------- 已移除的第三方插件（显式关闭）----------
# mosdns 分流整套与 OAF 的 LuCI 界面不再编入：源码树/feeds 里仍可能有同名包，
# 官方 configs/an7581.config 也已写成 is not set，这里再钉一次，
# 防止以后换基线或 feeds 默认值把它们悄悄带回来。
# 注意 kmod-oaf / appfilter 是【要】的（见上面「OAF 识别内核」一节），不在此列。
#
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-appfilter is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_geo2txt is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set

#
# luci-app-airoha-npu 靠 busybox devmem 读 FrameEngine/PLL 寄存器
#
CONFIG_BUSYBOX_DEFAULT_DEVMEM=y

#
# ---------- 常用工具 ----------
# 官方基线已含 curl 等，这里补齐日常排障用的
#
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

#
# ---------- 去除 dummy 接口 ----------
#
# CONFIG_PACKAGE_kmod-dummy is not set
