# PonWrt 叠加配置 — Nokia XG-040G-MD (UBI) / airoha an7581
#
# 构建时先 kconfig.pl + configs/an7581.config configs/release.config > .config
# 铺好官方基线，再追加本文件，最后 make defconfig。
# 这里只写基线之外的差异项。

CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# PON 驱动栈 / 光模块（必须 =y，=m 会导致首启光口起不来）
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pon-debug=y

# 2.5G PHY（lan1 2500base-x）
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y

# 硬件加速
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y

# 主题
CONFIG_PACKAGE_luci-theme-argon=y

# 插件（PON 页用上游 pbs05 的 luci-app-pon）
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-app-airoha-npu=y

# Lua 兼容层：oaf_status 是 Lua 控制器 + htm 模板，PonWrt 默认纯 ucode LuCI
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_libuci-lua=y

# OAF 后端（内核特征库 + oafd/appfilter）；官方 Lua 界面不编入，
# 界面用 files/ 里的 oaf_status（见 diy-part2 里删掉 luci-app-oaf）
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_libsqlite3=y
CONFIG_PACKAGE_libcurl=y

# oaf_status 的采集器：lua 解释器 + conntrack 事件流
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_conntrack=y

# UPnP（fw4 是 nftables，只能用 nftables 变体）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# CONFIG_PACKAGE_miniupnpd-iptables is not set

# 不编入
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-iptv is not set
# CONFIG_PACKAGE_luci-app-appfilter is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_geo2txt is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set
# CONFIG_PACKAGE_kmod-dummy is not set

# 本机无 WiFi（an7581 光猫，板上没有射频芯片），关掉上游基线带进来的无线栈
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_WIFI_SCRIPTS_UCODE is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wireless-regdb is not set

# luci-app-airoha-npu 靠 busybox devmem 读寄存器
CONFIG_BUSYBOX_DEFAULT_DEVMEM=y

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# 每流字节统计在 target/linux/airoha/an7581/config-6.18，见 diy-part2
